{
  "name": "kubi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/domain && tsc -b web && tsc -p server",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  }
}
